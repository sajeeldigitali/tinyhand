<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TinyHandVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</TinyHandVersion>
    <Version>$(TinyHandVersion)</Version>
    <Authors>Kamran Ahmed, Windows port</Authors>
    <Copyright>© Kamran Ahmed. MIT License.</Copyright>
    <Product>TinyHand</Product>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
